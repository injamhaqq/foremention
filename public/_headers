# Content-hashed build output (Vite/vinext `assets/` directory). File names
# change whenever content changes, so browsers and Cloudflare may cache them for
# a year without revalidation. vinext only generates this rule when no
# public/_headers exists, so it must be declared here explicitly.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.md
  Link: <https://foremention.com/>; rel="canonical"

/product.md
  Link: <https://foremention.com/product>; rel="canonical"

/methodology.md
  Link: <https://foremention.com/methodology>; rel="canonical"

/recommendation-record.md
  Link: <https://foremention.com/recommendation-record>; rel="canonical"

/recommendation-intelligence.md
  Link: <https://foremention.com/recommendation-intelligence>; rel="canonical"
