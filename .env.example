# Public app URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional ownership verification. This is not analytics.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Foremention product analytics is intentionally production-only. The connected
# PostHog browser project token and US ingestion host are pinned in
# lib/product-analytics.ts and capture is hostname-gated to foremention.com.
# Do not add NEXT_PUBLIC PostHog overrides for local, preview, test, or QA builds.

# Optional Contentsquare experience analytics. This public tag URL is loaded
# only after a visitor explicitly accepts optional analytics in the browser.
NEXT_PUBLIC_CONTENTSQUARE_TAG_URL=

# Optional Microsoft Clarity experience analytics. This public project ID is
# loaded only after a visitor explicitly accepts optional analytics in-browser.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Sentry monitoring (optional). The public DSN may be sent to the browser.
# Keep auth tokens and other secrets out of this file and the client.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Required to activate server and Cloudflare Worker error monitoring.
SENTRY_DSN=
FOREMENTION_BUILD_COMMIT=
SENTRY_ENVIRONMENT=development

# Optional product-alert delivery. Keep RESEND_API_KEY server-only. This is
# separate from Supabase/Zoho authentication and needs a verified sender domain
# plus a production delivery test before email alerts are called active.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_UNSUBSCRIBE_SECRET=
WEBHOOK_SIGNING_SECRET=

# Acquisition discovery/research is fail-closed. Keep the provider key server-side.
# The scheduled shadow pipeline performs no provider request when SGAI_API_KEY is absent.
SGAI_API_KEY=

# Acquisition first-touch remains disabled unless every safety gate below is
# explicitly configured and independently verified in production. The company
# operator allowlist is comma-separated and is checked against the authenticated
# Supabase viewer; demo sessions never receive operator access.
FOREMENTION_COMPANY_OPERATOR_EMAILS=
ACQUISITION_OUTREACH_SEND_ENABLED=false
ACQUISITION_OUTREACH_DELIVERABILITY_VERIFIED=false
ACQUISITION_OUTREACH_WEBHOOKS_VERIFIED=false
ACQUISITION_OUTREACH_FROM_EMAIL=
ACQUISITION_OUTREACH_REPLY_TO_EMAIL=
RESEND_WEBHOOK_SECRET=

# Optional workspace HubSpot/Notion/Google Sheets OAuth connectors. These are
# server-only integration credentials and are NOT used for account sign-in.
# Per-workspace OAuth credentials are encrypted before database storage.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_OAUTH_STATE_SECRET=
INTEGRATION_ENCRYPTION_KEY=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_OAUTH_STATE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# Supabase project (required for persistent auth and data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Keep this off until Google is enabled in Supabase Auth, the Google Cloud OAuth
# callback is registered, and a real production sign-in has been verified.
# Google account credentials live in Google/Supabase, never in Foremention source.
FOREMENTION_GOOGLE_AUTH_ENABLED=0

# Optional self-serve billing. Leave BILLING_PROVIDER_ID unset unless all provider
# credentials, webhook delivery, and at least one approved recurring Stripe Price
# are configured and verified. Intelligence/custom remain founder-led.
BILLING_PROVIDER_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly Price IDs. The legacy *_PRICE_ID names remain supported as fallback.
STRIPE_CORE_MONTHLY_PRICE_ID=
STRIPE_SIGNAL_MONTHLY_PRICE_ID=
STRIPE_CORE_PRICE_ID=
STRIPE_SIGNAL_PRICE_ID=
# Annual offers are independent. An annual CTA is unavailable unless its exact
# recurring Price ID is configured; application code never invents an amount.
STRIPE_CORE_ANNUAL_PRICE_ID=
STRIPE_SIGNAL_ANNUAL_PRICE_ID=
# Optional payment-failure grace in whole days, 0..30. Invalid/missing values
# fail closed to 0 (immediate paid-entitlement pause).
BILLING_GRACE_PERIOD_DAYS=0
# Generic signed-provider fallback. Stripe uses STRIPE_WEBHOOK_SECRET instead.
BILLING_WEBHOOK_SECRET=

# Inngest (required for live background runs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# At least one answer provider; mock mode works without these
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Cloudflare Workers AI uses the Worker AI binding, not a browser or repository API key.
# This adapter is answer-only because this model does not return web citations.
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
OPENROUTER_API_KEY=
# GLM 5.2 is low-cost, not free. Keep this explicit for comparable runs.
OPENROUTER_MODEL=z-ai/glm-5.2
# Optional OpenAI-compatible comparison gateways. They stay unavailable until
# a private API key, explicit model ID, and current cost rates are configured.
ZENMUX_API_KEY=
ZENMUX_MODEL=
OMNIROUTERS_API_KEY=
OMNIROUTERS_MODEL=
# Required cost controls for whichever live provider is selected.
# Use the provider's current official per-million-token prices.
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
OPENAI_REQUEST_COST_USD=
GEMINI_INPUT_COST_PER_MILLION_USD=
GEMINI_OUTPUT_COST_PER_MILLION_USD=
GEMINI_REQUEST_COST_USD=
ANTHROPIC_INPUT_COST_PER_MILLION_USD=
ANTHROPIC_OUTPUT_COST_PER_MILLION_USD=
ANTHROPIC_REQUEST_COST_USD=
PERPLEXITY_INPUT_COST_PER_MILLION_USD=
PERPLEXITY_OUTPUT_COST_PER_MILLION_USD=
PERPLEXITY_REQUEST_COST_USD=
GROQ_INPUT_COST_PER_MILLION_USD=0.075
GROQ_OUTPUT_COST_PER_MILLION_USD=0.30
# Conservative application-side reservation for mandatory Browser Search tool use.
# This is a budgeting reserve, not a provider-side hard cap on browser operations.
GROQ_REQUEST_COST_USD=0.05
CLOUDFLARE_INPUT_COST_PER_MILLION_USD=0.10
CLOUDFLARE_OUTPUT_COST_PER_MILLION_USD=0.30
CLOUDFLARE_REQUEST_COST_USD=0
OPENROUTER_INPUT_COST_PER_MILLION_USD=0.7238
OPENROUTER_OUTPUT_COST_PER_MILLION_USD=2.2748
OPENROUTER_REQUEST_COST_USD=0
ZENMUX_INPUT_COST_PER_MILLION_USD=
ZENMUX_OUTPUT_COST_PER_MILLION_USD=
ZENMUX_REQUEST_COST_USD=
OMNIROUTERS_INPUT_COST_PER_MILLION_USD=
OMNIROUTERS_OUTPUT_COST_PER_MILLION_USD=
OMNIROUTERS_REQUEST_COST_USD=
# Independent hard ceiling checked before a run is queued.
FOREMENTION_MAX_RUN_COST_USD=0.25
PUBLIC_TOOL_MAX_REQUEST_COST_USD=0.04
PUBLIC_RATE_LIMIT_SECRET=
