# Public app URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional ownership verification. This is not analytics.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# PostHog EU product analytics (optional). The browser project token is public
# by design; never place a PostHog personal API key here. Session replay,
# autocapture, form values, provider answers, citations and customer content
# remain disabled in the application integration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry monitoring (optional). The public DSN may be sent to the browser.
# Keep auth tokens and other secrets out of this file and the client.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Supabase project (required for persistent auth and data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inngest (required for live background runs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# At least one answer provider; mock mode works without these
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
GROQ_MODEL_VERSION=2025-07-23
# Cloudflare Workers AI uses the Worker AI binding, not a browser or repository API key.
# This adapter is answer-only because this model does not return web citations.
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
OPENROUTER_API_KEY=
# GLM 5.2 is low-cost, not free. Keep this explicit for comparable runs.
OPENROUTER_MODEL=z-ai/glm-5.2
# Optional OpenAI-compatible comparison gateways. They stay unavailable until
# a private API key, explicit model ID, and current cost rates are configured.
ZENMUX_API_KEY=
ZENMUX_MODEL=
OMNIROUTERS_API_KEY=
OMNIROUTERS_MODEL=
# Required cost controls for whichever live provider is selected.
# Use the provider's current official per-million-token prices.
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
OPENAI_REQUEST_COST_USD=
GEMINI_INPUT_COST_PER_MILLION_USD=
GEMINI_OUTPUT_COST_PER_MILLION_USD=
GEMINI_REQUEST_COST_USD=
ANTHROPIC_INPUT_COST_PER_MILLION_USD=
ANTHROPIC_OUTPUT_COST_PER_MILLION_USD=
ANTHROPIC_REQUEST_COST_USD=
PERPLEXITY_INPUT_COST_PER_MILLION_USD=
PERPLEXITY_OUTPUT_COST_PER_MILLION_USD=
PERPLEXITY_REQUEST_COST_USD=
GROQ_INPUT_COST_PER_MILLION_USD=
GROQ_OUTPUT_COST_PER_MILLION_USD=
GROQ_REQUEST_COST_USD=
CLOUDFLARE_INPUT_COST_PER_MILLION_USD=0.10
CLOUDFLARE_OUTPUT_COST_PER_MILLION_USD=0.30
CLOUDFLARE_REQUEST_COST_USD=0
OPENROUTER_INPUT_COST_PER_MILLION_USD=0.7238
OPENROUTER_OUTPUT_COST_PER_MILLION_USD=2.2748
OPENROUTER_REQUEST_COST_USD=0
ZENMUX_INPUT_COST_PER_MILLION_USD=
ZENMUX_OUTPUT_COST_PER_MILLION_USD=
ZENMUX_REQUEST_COST_USD=
OMNIROUTERS_INPUT_COST_PER_MILLION_USD=
OMNIROUTERS_OUTPUT_COST_PER_MILLION_USD=
OMNIROUTERS_REQUEST_COST_USD=
# Independent hard ceiling checked before a run is queued.
FOREMENTION_MAX_RUN_COST_USD=0.25
