# Public app URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry monitoring (optional). The public DSN may be sent to the browser.
# Keep auth tokens and other secrets out of this file and the client.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Supabase project (required for persistent auth and data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inngest (required for live background runs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# At least one answer provider; mock mode works without these
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
