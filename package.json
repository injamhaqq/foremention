{
    "name": "foremention-mvp",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.25.0",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "vinext dev",
        "build": "vinext build && node scripts/prepare-worker-config.mjs",
        "start": "vinext start",
        "dev:next": "next dev",
        "build:next": "next build",
        "start:next": "next start",
        "test": "node --experimental-strip-types --test tests/*.test.mjs",
        "eval:ai": "node scripts/run-ai-evaluation.mjs",
        "eval:gate": "node scripts/verify-ai-evaluation-gate.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler-dry-run --ignore-pattern scripts/codex-*"
    },
    "dependencies": {
        "@sentry/cloudflare": "^11.1.0",
        "@sentry/react": "^11.1.0",
        "inngest": "^4.21.0",
        "next": "16.3.7",
        "posthog-js": "^1.435.3",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.62.2",
        "@types/node": "26.6.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "@vitejs/plugin-rsc": "0.5.35",
        "eslint": "10.11.0",
        "eslint-config-next": "16.3.7",
        "react-server-dom-webpack": "19.3.0",
        "typescript": "7.0.2",
        "vinext": "1.0.0",
        "vite": "8.3.1",
        "wrangler": "4.144.0",
        "@foremention/braces": "file:vendor/braces",
        "@foremention/micromatch": "file:vendor/micromatch"
    },
    "type": "module"
}
