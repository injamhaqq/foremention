{
    "name": "foremention-mvp",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.25.0",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "vinext dev",
        "build": "vinext build && node scripts/prepare-worker-config.mjs",
        "start": "vinext start",
        "dev:next": "next dev",
        "build:next": "next build",
        "start:next": "next start",
        "test": "node --experimental-strip-types --test tests/*.test.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler-dry-run --ignore-pattern scripts/codex-*"
    },
    "dependencies": {
        "@sentry/cloudflare": "^10.70.0",
        "@sentry/react": "^10.70.0",
        "inngest": "^4.18.1",
        "next": "16.3.1",
        "posthog-js": "^1.418.5",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.53.0",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.1.0",
        "@vitejs/plugin-rsc": "0.5.34",
        "eslint": "10.8.1",
        "eslint-config-next": "16.3.1",
        "react-server-dom-webpack": "19.2.8",
        "typescript": "7.0.2",
        "vinext": "0.2.1",
        "vite": "8.2.2",
        "wrangler": "4.124.0"
    },
    "type": "module"
}
